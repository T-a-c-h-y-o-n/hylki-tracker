# Environment variables for the Vercel project.
#
# Copy the real values from your Upstash Redis database (Vercel → Storage →
# Marketplace → Upstash) into Vercel's Project → Settings → Environment
# Variables. The two UPSTASH_* names are the ones Upstash injects itself when
# you connect a database to the project, so usually you only add TRACKER_SECRET.

# Upstash Redis REST endpoint and token.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Protects the read side (/api/opens). Anyone with this string can see which
# messages were opened and by whom, so make it long and random:
#   openssl rand -base64 32
TRACKER_SECRET=change-me

# The public address the pixel URLs are built from. Hylki reads this to know
# where to point its images and where to ask for open counts.
TRACKER_PUBLIC_URL=https://your-project.vercel.app
